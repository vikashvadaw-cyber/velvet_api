{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "jwt": {
    "Token": "qwertyuiop1234567890asdfghjkl1zxcvbnm4629qhrnakrudbclo038@ndu#*b",
    "Issuer": "MyOttApp",
    "Audience": "MyOttAudience"
  },
  "ReverseProxy": {
    "Routes": {
      "login-route": {
        "ClusterId": "admin-cluster",
        "AutorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/Admin/Login",
          "Methods": [ "POST" ]
        }
      },
      "register-route": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/Admin/RegisterUser",
          "Methods": [ "POST" ]
        }
      },
      "refreshtoken-route": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/Admin/RefreshToken",
          "Methods": [ "POST" ]
        }
      },
      "admin-protected-route": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "Default",
        "Order": 2,
        "Match": {
          "Path": "/Admin/{**catch-all}"
        },
        "Transforms": [ { "PathRemovePrefix": "/Admin" } ]
      },
      "Movies-route": {
        "ClusterId": "movies-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/movies/{**catch-all}"
        }
      },



      "admin-openapi-route": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/Admin-docs/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "movies-openapi-route": {
        "ClusterId": "movies-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/movies-docs/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }

    },
    "Clusters": {
      "admin-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5251/"
          }
        }
      },
        "movies-cluster": {
          "Destinations": {
            "d1": {
              "Address": "http://localhost:5003/"
            }
          }
        }
      }
    }
  }


